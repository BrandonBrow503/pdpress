{
  "name": "Public Domain Press",
  "short_name": "PD Press",
  "description": "Plan, check and price new editions of public-domain books.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#2b2118",
  "theme_color": "#2b2118",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./?share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "bundle",
          "accept": [
            "*/*",
            "application/zip",
            "application/x-zip-compressed",
            "application/json",
            "application/octet-stream",
            "application/epub+zip",
            "application/pdf",
            "image/*",
            "text/*",
            ".zip",
            ".json",
            ".pdpress",
            ".epub",
            ".pdf",
            ".txt",
            ".md",
            ".docx"
          ]
        }
      ]
    }
  }
}